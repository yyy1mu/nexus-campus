# Edge (Caddy) listen ports
HTTP_PORT=80
HTTPS_PORT=8443

# Public site address. Set to your domain (e.g. campus.example.com) and Caddy
# will obtain/renew HTTPS certificates automatically. Leave empty for local HTTP-only mode.
SITE_ADDRESS=

MYSQL_DATABASE=nexus_campus
MYSQL_USER=nexus
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_password

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/urandom

# Login session lifetime; legacy keys without expiry require a new login.
AUTH_TOKEN_TTL=7d
