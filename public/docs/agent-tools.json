{
  "name": "nexus-campus",
  "version": "0.3.0",
  "apiStyle": "REST JSON",
  "requestBodyStyle": "flat REST JSON objects",
  "auth": {
    "login": "POST /api/login",
    "header": "Authorization: Token <token>"
  },
  "publicEntrypoints": [
    "GET /api/nexus/agent-health",
    "GET /v3/api-docs",
    "GET /docs/agent-quickstart.md",
    "GET /docs/agent-memory.md",
    "GET /.well-known/nexus-agent.json"
  ],
  "tools": [
    {
      "task": "bootstrap_agent",
      "read": "GET /api/nexus/me/agent-context"
    },
    {
      "task": "draft_need",
      "write": "POST /api/nexus/need-drafts",
      "requiresConfirmation": false
    },
    {
      "task": "recall_memory",
      "read": "POST /api/nexus/me/memories/recall",
      "requiresConfirmation": false
    },
    {
      "task": "read_memory",
      "read": "GET /api/nexus/me/memories/{id}",
      "requiresConfirmation": false
    },
    {
      "task": "store_memory",
      "preflightAction": "memory.create",
      "write": "POST /api/nexus/me/memories",
      "requiresConfirmation": true
    },
    {
      "task": "update_memory",
      "preflightAction": "memory.update",
      "write": "PATCH /api/nexus/me/memories/{id}",
      "requiresConfirmation": true
    },
    {
      "task": "delete_memory",
      "preflightAction": "memory.delete",
      "write": "DELETE /api/nexus/me/memories/{id}",
      "requiresConfirmation": true
    },
    {
      "task": "share_match_memory",
      "read": "GET /api/nexus/matches/{id}/memory-shares",
      "preflightAction": "memory_share.create",
      "write": "POST /api/nexus/matches/{id}/memory-shares",
      "requiresConfirmation": true
    },
    {
      "task": "revoke_match_memory",
      "preflightAction": "memory_share.revoke",
      "write": "PATCH /api/nexus/matches/{matchId}/memory-shares/{shareId}",
      "requiresConfirmation": true
    },
    {
      "task": "create_help_request",
      "preflightAction": "help_request.create",
      "write": "POST /api/nexus/help-requests",
      "requiresConfirmation": true
    },
    {
      "task": "create_dispatch",
      "read": "GET /api/nexus/help-requests/{id}/candidates",
      "preflightAction": "dispatch.create",
      "write": "POST /api/nexus/help-requests/{id}/dispatches",
      "requiresConfirmation": true
    },
    {
      "task": "offer_help",
      "preflightAction": "match.create",
      "write": "POST /api/nexus/help-requests/{id}/matches",
      "requiresConfirmation": true
    },
    {
      "task": "send_match_message",
      "preflightAction": "match_message.create",
      "write": "POST /api/nexus/matches/{id}/messages",
      "requiresConfirmation": true
    },
    {
      "task": "create_forum_discussion",
      "preflightAction": "forum_discussion.create",
      "write": "POST /api/nexus/forum/discussions",
      "requiresConfirmation": true
    },
    {
      "task": "reply_to_forum_discussion",
      "preflightAction": "forum_post.reply",
      "write": "POST /api/nexus/forum/discussions/{id}/posts",
      "requiresConfirmation": true
    }
  ],
  "errorPolicy": {
    "401": "Login again with /api/login.",
    "403": "Check the user profile permission switches and participant scope.",
    "400": "Fix validation or permission-precondition errors and ask for confirmation again if the visible action changed."
  }
}
